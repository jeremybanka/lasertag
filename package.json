{
	"name": "lasertag-workspace",
	"private": true,
	"license": "MPL-2.0",
	"type": "module",
	"scripts": {
		"build": "vp run -r build",
		"change": "changeset",
		"check": "pnpm run \"/^check:.*/\"",
		"check:correctly": "correctly check --offline",
		"check:eslint": "vp run -r check:eslint",
		"check:fmt": "dprint check",
		"check:vp": "vp check --no-fmt",
		"check:spelling": "cspell .",
		"fmt": "dprint fmt",
		"refractor:corpus": "./scripts/fetch-refractor-corpus.node.ts",
		"refractor:corpus:test": "./scripts/test-refractor-corpus.node.ts",
		"release:publish": "pnpm build && changeset publish",
		"release:version": "changeset version",
		"staged": "vp staged",
		"test": "vp run -r test",
		"test:breakage": "vp run -r --no-cache test:breakage",
		"test:watch": "vp run -r --parallel --no-cache test:watch",
		"workflows:update": "./scripts/update-workflows.node.ts"
	},
	"devDependencies": {
		"@changesets/cli": "3.0.3",
		"@changesets/config": "4.0.1",
		"@dprint/json": "0.25.2",
		"@dprint/markdown": "0.28.2",
		"@dprint/oxc": "0.47.0",
		"@dprint/toml": "0.9.0",
		"correctly": "0.3.3",
		"cspell": "10.4.0",
		"dprint": "0.64.3",
		"dprint-plugin-malva": "0.16.0",
		"dprint-plugin-markup": "0.27.6",
		"dprint-plugin-yaml": "0.6.0",
		"typescript": "7.1.0-dev.20261027.1",
		"vite-plus": "catalog:"
	},
	"packageManager": "pnpm@12.15.0",
	"engines": {
		"node": "26.12.1",
		"pnpm": "12.15.0"
	}
}
