{
	"name": "lasertag-workspace",
	"license": "MPL-2.0",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "vp run -r build",
		"change": "changeset",
		"check": "vp check --no-fmt && tsc --noEmit",
		"check:eslint": "vp run -r check:eslint",
		"fmt": "dprint fmt",
		"fmt:check": "dprint check",
		"lint": "vp lint",
		"release": "pnpm build && changeset publish",
		"refractor:corpus": "./scripts/fetch-refractor-corpus.node.ts",
		"refractor:corpus:test": "./scripts/test-refractor-corpus.node.ts",
		"spellcheck": "cspell .",
		"staged": "vp staged",
		"test": "vp run -r test",
		"test:semver": "break-check",
		"workflows": "./scripts/update-workflows.node.ts"
	},
	"devDependencies": {
		"@changesets/cli": "3.0.2",
		"@changesets/config": "4.0.0",
		"@dprint/json": "0.23.0",
		"@dprint/markdown": "0.23.3",
		"@dprint/oxc": "0.38.0",
		"@dprint/toml": "0.8.0",
		"break-check": "0.6.36",
		"cspell": "10.2.2",
		"dprint": "0.57.1",
		"dprint-plugin-malva": "0.16.0",
		"dprint-plugin-markup": "0.27.3",
		"dprint-plugin-yaml": "0.6.0",
		"typescript": "7.0.2",
		"vite-plus": "0.3.0"
	},
	"engines": {
		"node": "26.8.1",
		"pnpm": "12.3.4"
	},
	"packageManager": "pnpm@12.3.4"
}
