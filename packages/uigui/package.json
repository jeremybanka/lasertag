{
	"name": "uigui",
	"version": "0.1.0",
	"description": "zero-runtime css framework for jsx with css modules",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/jeremybanka/uigui.git"
	},
	"files": [
		"docs",
		"examples",
		"types",
		"AGENTS.md"
	],
	"type": "module",
	"exports": {
		"./package.json": "./package.json",
		"./css-modules": {
			"types": "./types/module.css.d.ts"
		},
		"./react-jsx": {
			"types": "./types/react-jsx-intrinsic-elements.d.ts"
		},
		"./preact-jsx": {
			"types": "./types/preact-jsx-intrinsic-elements.d.ts"
		},
		"./solid-jsx": {
			"types": "./types/solid-jsx-intrinsic-elements.d.ts"
		}
	},
	"scripts": {
		"typecheck:examples": "tsc -p examples/react/tsconfig.json && tsc -p examples/preact/tsconfig.json && tsc -p examples/solid-js/tsconfig.json",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {},
	"devDependencies": {
		"@types/react": "19.2.17",
		"preact": "10.29.2",
		"solid-js": "1.9.13",
		"tsdown": "0.22.2",
		"typescript": "6.0.3"
	},
	"peerDependencies": {
		"@types/react": "^19.2",
		"preact": "^10.29",
		"solid-js": "^1.9"
	},
	"peerDependenciesMeta": {
		"@types/react": {
			"optional": true
		},
		"preact": {
			"optional": true
		},
		"solid-js": {
			"optional": true
		}
	},
	"engines": {
		"node": "26.3.0",
		"pnpm": "11.5.2"
	},
	"packageManager": "pnpm@11.5.2"
}
