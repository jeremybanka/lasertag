{
	"name": "uigui",
	"version": "0.1.0",
	"description": "zero-runtime css framework for jsx with css modules",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/jeremybanka/uigui.git"
	},
	"files": [
		"docs",
		"eslint/dist",
		"examples",
		"templates",
		"types",
		"AGENTS.md"
	],
	"type": "module",
	"exports": {
		"./package.json": "./package.json",
		"./css-modules": {
			"types": "./types/module.css.d.ts"
		},
		"./react-jsx": {
			"types": "./types/react-jsx-intrinsic-elements.d.ts"
		},
		"./preact-jsx": {
			"types": "./types/preact-jsx-intrinsic-elements.d.ts"
		},
		"./solid-jsx": {
			"types": "./types/solid-jsx-intrinsic-elements.d.ts"
		},
		"./eslint-plugin": {
			"import": "./eslint/dist/plugin.mjs",
			"types": "./eslint/dist/plugin.d.mts"
		}
	},
	"scripts": {
		"build:eslint": "tsdown eslint/src/plugin.ts --out-dir eslint/dist --format esm --dts --clean",
		"typecheck:examples": "tsc -p examples/react/tsconfig.json && tsc -p examples/preact/tsconfig.json && tsc -p examples/solid-js/tsconfig.json",
		"typecheck": "tsc --noEmit"
	},
	"devDependencies": {
		"@eslint/core": "1.2.1",
		"@types/estree": "1.0.9",
		"@types/react": "19.2.17",
		"@typescript-eslint/parser": "8.56.1",
		"eslint": "10.4.1",
		"preact": "10.29.2",
		"solid-js": "1.9.13",
		"tsdown": "0.22.2",
		"typescript": "6.0.3",
		"vitest": "npm:@voidzero-dev/vite-plus-test@0.1.24"
	},
	"peerDependencies": {
		"@types/react": "^19.2",
		"eslint": "^10.4",
		"preact": "^10.29",
		"solid-js": "^1.9"
	},
	"peerDependenciesMeta": {
		"@types/react": {
			"optional": true
		},
		"eslint": {
			"optional": true
		},
		"preact": {
			"optional": true
		},
		"solid-js": {
			"optional": true
		}
	},
	"engines": {
		"node": "26.3.0",
		"pnpm": "11.5.2"
	},
	"packageManager": "pnpm@11.5.2"
}
