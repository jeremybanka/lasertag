{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"title": "Lasertag Refractor Corpus Manifest",
	"type": "object",
	"additionalProperties": false,
	"required": ["providers"],
	"properties": {
		"$schema": {
			"type": "string"
		},
		"providers": {
			"type": "array",
			"minItems": 1,
			"items": {
				"type": "object",
				"additionalProperties": false,
				"required": [
					"name",
					"description",
					"version",
					"renovate",
					"source",
					"license",
					"include"
				],
				"properties": {
					"name": {
						"type": "string",
						"pattern": "^[a-z0-9-]+$"
					},
					"description": {
						"type": "string"
					},
					"version": {
						"type": "string"
					},
					"renovate": {
						"type": "object",
						"additionalProperties": false,
						"required": ["datasource", "packageName", "versioning"],
						"properties": {
							"datasource": {
								"type": "string"
							},
							"packageName": {
								"type": "string"
							},
							"versioning": {
								"type": "string"
							},
							"extractVersion": {
								"type": "string"
							}
						}
					},
					"source": {
						"oneOf": [
							{
								"type": "object",
								"additionalProperties": false,
								"required": ["kind", "repository", "refTemplate"],
								"properties": {
									"kind": {
										"const": "github-archive"
									},
									"repository": {
										"type": "string"
									},
									"refTemplate": {
										"type": "string"
									}
								}
							},
							{
								"type": "object",
								"additionalProperties": false,
								"required": ["kind", "packageName"],
								"properties": {
									"kind": {
										"const": "npm-sourcemaps"
									},
									"packageName": {
										"type": "string"
									}
								}
							}
						]
					},
					"license": {
						"type": "string"
					},
					"maxFiles": {
						"type": "integer",
						"minimum": 1
					},
					"include": {
						"type": "array",
						"minItems": 1,
						"items": {
							"type": "object",
							"additionalProperties": false,
							"required": ["from", "coverage"],
							"properties": {
								"from": {
									"type": "string"
								},
								"coverage": {
									"type": "array",
									"items": {
										"type": "string"
									}
								}
							}
						}
					}
				}
			}
		}
	}
}
