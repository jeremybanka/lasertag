{
	"name": "lasertag",
	"version": "0.8.7",
	"description": "zero-runtime structural css for jsx with css modules",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/jeremybanka/lasertag.git",
		"directory": "packages/lasertag"
	},
	"license": "MPL-2.0",
	"type": "module",
	"exports": {
		"./package.json": "./package.json",
		"./css-modules": {
			"types": "./src/types/module.css.d.ts"
		},
		"./react-jsx": {
			"types": "./src/types/react-jsx-intrinsic-elements.d.ts"
		},
		"./preact-jsx": {
			"types": "./src/types/preact-jsx-intrinsic-elements.d.ts"
		},
		"./solid-jsx": {
			"types": "./src/types/solid-jsx-intrinsic-elements.d.ts"
		},
		"./hono-jsx": {
			"types": "./src/types/hono-jsx-intrinsic-elements.d.ts"
		},
		"./eslint-plugin": {
			"import": "./dist/eslint-plugin.mjs",
			"types": "./dist/eslint-plugin.d.mts"
		},
		"./refractor": {
			"import": "./dist/refractor.mjs",
			"types": "./dist/refractor.d.mts"
		},
		"./lsp": {
			"import": "./dist/lsp.mjs"
		}
	},
	"bin": {
		"lasertag": "./dist/cli.mjs",
		"lasertag-lsp": "./dist/lsp.mjs"
	},
	"files": [
		"LICENSE",
		"dist/*.d.mts",
		"dist/*.d.mts.map",
		"dist/*.mjs",
		"dist/*.mjs.map",
		"docs",
		"examples",
		"src",
		"templates",
		"AGENTS.md"
	],
	"scripts": {
		"benchmark:lsp": "node benchmarks/lsp-analysis.ts",
		"build": "vp pack",
		"check:eslint": "eslint",
		"test": "vp test",
		"test:breaks": "break-check break-check.config.json --verbose",
		"test:private": "vp test tests/private",
		"test:public": "vp test tests/public",
		"test:watch": "vp test watch"
	},
	"dependencies": {
		"@astrojs/compiler": "4.0.0",
		"@vscode/vsce": "4.0.0",
		"atom.io": "0.53.3",
		"comline": "0.9.0",
		"rolldown": "1.2.12",
		"takua": "0.2.3",
		"tinyglobby": "0.2.17",
		"typescript": "7.0.2",
		"vscode-languageclient": "10.1.2",
		"vscode-languageserver": "10.1.2",
		"vscode-languageserver-textdocument": "1.0.15",
		"zod": "4.6.5"
	},
	"devDependencies": {
		"@babel/core": "8.0.7",
		"@eslint/core": "1.2.1",
		"@types/babel__core": "7.20.5",
		"@types/estree": "1.0.9",
		"@types/node": "26.6.4",
		"@types/react": "19.3.0",
		"@typescript-eslint/parser": "8.71.1",
		"@typescript-eslint/utils": "8.71.1",
		"babel-preset-solid": "1.9.16",
		"break-check": "0.8.2",
		"eslint": "10.12.0",
		"hono": "4.13.13",
		"jiti": "2.7.0",
		"preact": "11.0.0",
		"solid-js": "1.9.16"
	},
	"peerDependencies": {
		"@types/react": "^19.2",
		"eslint": "^10.4",
		"hono": "^4.13.8",
		"preact": "^10.29 || ^11.0.0",
		"solid-js": "^1.9"
	},
	"peerDependenciesMeta": {
		"@types/react": {
			"optional": true
		},
		"eslint": {
			"optional": true
		},
		"hono": {
			"optional": true
		},
		"preact": {
			"optional": true
		},
		"solid-js": {
			"optional": true
		}
	},
	"packageManager": "pnpm@12.10.1",
	"engines": {
		"node": "26.11.1",
		"pnpm": "12.10.1"
	}
}
