{
	"name": "lasertag",
	"version": "0.4.1",
	"description": "zero-runtime structural css for jsx with css modules",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/jeremybanka/lasertag.git",
		"directory": "packages/lasertag"
	},
	"files": [
		"dist/*.d.mts",
		"dist/*.d.mts.map",
		"dist/*.mjs",
		"dist/*.mjs.map",
		"docs",
		"examples",
		"src",
		"templates",
		"AGENTS.md"
	],
	"type": "module",
	"exports": {
		"./package.json": "./package.json",
		"./css-modules": {
			"types": "./src/types/module.css.d.ts"
		},
		"./react-jsx": {
			"types": "./src/types/react-jsx-intrinsic-elements.d.ts"
		},
		"./preact-jsx": {
			"types": "./src/types/preact-jsx-intrinsic-elements.d.ts"
		},
		"./solid-jsx": {
			"types": "./src/types/solid-jsx-intrinsic-elements.d.ts"
		},
		"./eslint-plugin": {
			"import": "./dist/eslint-plugin.mjs",
			"types": "./dist/eslint-plugin.d.mts"
		},
		"./refractor": {
			"import": "./dist/refractor.mjs",
			"types": "./dist/refractor.d.mts"
		},
		"./lsp": {
			"import": "./dist/lsp.mjs"
		}
	},
	"bin": {
		"lasertag": "./dist/cli.mjs",
		"lasertag-lsp": "./dist/lsp.mjs"
	},
	"scripts": {
		"build": "vp pack",
		"test": "vp test"
	},
	"dependencies": {
		"@vscode/vsce": "3.9.2",
		"atom.io": "0.49.7",
		"comline": "0.5.1",
		"rolldown": "1.1.5",
		"takua": "0.2.2",
		"tinyglobby": "0.2.17",
		"typescript": "7.0.2",
		"vscode-languageserver": "10.1.0",
		"vscode-languageserver-textdocument": "1.0.12",
		"zod": "4.4.3"
	},
	"devDependencies": {
		"@eslint/core": "1.2.1",
		"@types/estree": "1.0.9",
		"@types/node": "26.1.1",
		"@types/react": "19.2.17",
		"eslint": "10.6.0",
		"preact": "10.29.7",
		"solid-js": "1.9.14",
		"vitest": "npm:@voidzero-dev/vite-plus-test@0.1.24",
		"vscode-languageclient": "10.1.0"
	},
	"peerDependencies": {
		"@types/react": "^19.2",
		"eslint": "^10.4",
		"preact": "^10.29",
		"solid-js": "^1.9"
	},
	"peerDependenciesMeta": {
		"@types/react": {
			"optional": true
		},
		"eslint": {
			"optional": true
		},
		"preact": {
			"optional": true
		},
		"solid-js": {
			"optional": true
		}
	},
	"engines": {
		"node": "26.5.0",
		"pnpm": "11.11.0"
	},
	"packageManager": "pnpm@11.11.0"
}
