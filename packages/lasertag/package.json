{
	"name": "lasertag",
	"version": "0.1.6",
	"description": "zero-runtime structural css for jsx with css modules",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/jeremybanka/lasertag.git",
		"directory": "packages/lasertag"
	},
	"files": [
		"cli",
		"dist",
		"docs",
		"eslint",
		"examples",
		"lsp",
		"refractor",
		"templates",
		"types",
		"AGENTS.md"
	],
	"type": "module",
	"exports": {
		"./package.json": "./package.json",
		"./css-modules": {
			"types": "./types/module.css.d.ts"
		},
		"./react-jsx": {
			"types": "./types/react-jsx-intrinsic-elements.d.ts"
		},
		"./preact-jsx": {
			"types": "./types/preact-jsx-intrinsic-elements.d.ts"
		},
		"./solid-jsx": {
			"types": "./types/solid-jsx-intrinsic-elements.d.ts"
		},
		"./eslint-plugin": {
			"import": "./dist/eslint-plugin.mjs",
			"types": "./dist/eslint-plugin.d.mts"
		},
		"./refractor": {
			"import": "./dist/refractor.mjs",
			"types": "./dist/refractor.d.mts"
		},
		"./lsp": {
			"import": "./dist/lsp.mjs",
			"types": "./dist/lsp.d.mts"
		}
	},
	"bin": {
		"lasertag": "./dist/cli.mjs",
		"lasertag-lsp": "./dist/lsp.mjs"
	},
	"scripts": {
		"build": "vp pack",
		"test": "vp test"
	},
	"devDependencies": {
		"@eslint/core": "1.2.1",
		"@types/estree": "1.0.9",
		"@types/react": "19.2.17",
		"@typescript-eslint/parser": "8.63.0",
		"eslint": "10.6.0",
		"preact": "10.29.5",
		"solid-js": "1.9.14",
		"typescript": "6.0.3",
		"vitest": "npm:@voidzero-dev/vite-plus-test@0.1.24"
	},
	"peerDependencies": {
		"@types/react": "^19.2",
		"eslint": "^10.4",
		"preact": "^10.29",
		"solid-js": "^1.9"
	},
	"peerDependenciesMeta": {
		"@types/react": {
			"optional": true
		},
		"eslint": {
			"optional": true
		},
		"preact": {
			"optional": true
		},
		"solid-js": {
			"optional": true
		}
	},
	"engines": {
		"node": "26.4.0",
		"pnpm": "11.10.0"
	},
	"packageManager": "pnpm@11.10.0",
	"dependencies": {
		"comline": "0.5.0",
		"tinyglobby": "0.2.17",
		"vscode-languageserver": "10.1.0",
		"vscode-languageserver-textdocument": "1.0.12",
		"zod": "4.4.3"
	}
}
