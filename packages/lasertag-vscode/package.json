{
	"name": "lasertag-vscode",
	"displayName": "lasertag",
	"description": "VSCode diagnostics for lasertag CSS module reachability.",
	"version": "0.1.1",
	"publisher": "lasertag",
	"repository": {
		"type": "git",
		"url": "https://github.com/jeremybanka/lasertag.git",
		"directory": "packages/lasertag-vscode"
	},
	"license": "MIT",
	"engines": {
		"vscode": "^1.100.0"
	},
	"categories": [
		"Linters",
		"Programming Languages"
	],
	"activationEvents": [
		"onLanguage:css",
		"onLanguage:typescriptreact",
		"workspaceContains:**/*.module.css"
	],
	"extensionKind": [
		"workspace"
	],
	"icon": "dist/LasertagIcon.png",
	"main": "./dist/extension.cjs",
	"files": [
		"dist",
		"README.md"
	],
	"contributes": {
		"configuration": {
			"title": "lasertag",
			"properties": {
				"lasertag.server.path": {
					"type": "string",
					"default": "",
					"description": "Optional absolute path to a lasertag-lsp server module. Leave empty to use the bundled server."
				},
				"lasertag.trace.server": {
					"type": "string",
					"enum": [
						"off",
						"messages",
						"verbose"
					],
					"default": "off",
					"description": "Trace communication between VSCode and the lasertag language server."
				}
			}
		}
	},
	"scripts": {
		"build": "tsdown --config tsdown.config.mts",
		"bundle": "pnpm run clean && pnpm run copy:icon && pnpm run build",
		"check": "node --check extension.js && node --check scripts/package.mjs && node --check tsdown.config.mts",
		"clean": "node -e \"fs.rmSync('dist', { force: true, recursive: true })\"",
		"copy:icon": "node -e \"fs.mkdirSync('dist', { recursive: true }); fs.copyFileSync('../../LasertagIcon.png', 'dist/LasertagIcon.png')\"",
		"package": "node scripts/package.mjs",
		"vscode:prepublish": "pnpm run bundle"
	},
	"devDependencies": {
		"@vscode/vsce": "3.9.2",
		"atom.io": "0.49.6",
		"tinyglobby": "0.2.17",
		"tsdown": "0.22.3",
		"typescript": "6.0.3",
		"vscode-languageclient": "10.1.0",
		"vscode-languageserver": "10.1.0",
		"vscode-languageserver-textdocument": "1.0.12"
	}
}
