{
	"$schema": "https://docs.renovatebot.com/renovate-schema.json",
	"extends": ["config:recommended"],
	"automerge": true,
	"branchConcurrentLimit": 9,
	"internalChecksFilter": "strict",
	"minimumReleaseAge": "1 day",
	"prConcurrentLimit": 3,
	"prHourlyLimit": 9,
	"pruneBranchAfterAutomerge": true,
	"pruneStaleBranches": true,
	"statusCheckWhen": { "minimumReleaseAge": "never" },
	"customManagers": [
		{
			"customType": "regex",
			"managerFilePatterns": ["/^\\.github\\/actions\\/setup\\/action\\.yml$/"],
			"matchStrings": [
				"uses: jdx\\/mise-action@\\S+(?:\\s+#.*)?\\s+      with:\\s+        version: (?<currentValue>\\S+)"
			],
			"depNameTemplate": "jdx/mise",
			"datasourceTemplate": "github-releases",
			"versioningTemplate": "semver-coerced"
		},
		{
			"customType": "regex",
			"description": "Update release-pinned refractor render corpus providers",
			"managerFilePatterns": [
				"/^packages\\/lasertag\\/refractor\\/corpus\\/manifest\\.json$/"
			],
			"matchStrings": [
				"\"version\"\\s*:\\s*\"(?<currentValue>[^\"]+)\"\\s*,\\s*\"renovate\"\\s*:\\s*\\{\\s*\"datasource\"\\s*:\\s*\"(?<datasource>[^\"]+)\"\\s*,\\s*\"packageName\"\\s*:\\s*\"(?<packageName>[^\"]+)\"\\s*,\\s*\"versioning\"\\s*:\\s*\"(?<versioning>[^\"]+)\"(?:\\s*,\\s*\"extractVersion\"\\s*:\\s*\"(?<extractVersion>[^\"]+)\")?\\s*\\}"
			]
		}
	],
	"packageRules": [
		{
			"matchPackageNames": ["jdx/mise"],
			"matchDatasources": ["github-releases"],
			"ignoreUnstable": true
		},
		{
			"groupName": "vite-plus",
			"matchPackageNames": [
				"vite",
				"vitest",
				"vite-plus",
				"@vitejs/*",
				"@vitest/*",
				"@voidzero-dev/vite-plus-core"
			],
			"separateMajorMinor": false,
			"groupSingleUpdates": true,
			"group": {
				"commitMessageTopic": "{{{groupName}}}{{#each upgrades}}{{#if (equals depName 'vite-plus')}} to v{{{newVersion}}}{{/if}}{{/each}}",
				"commitMessageExtra": ""
			},
			"skipArtifactsUpdate": true,
			"postUpgradeTasks": {
				"commands": [
					"{{#if (includes (lookupArray upgrades 'depName') 'vite-plus')}}pnpm dlx --package=vite-plus@{{#each upgrades}}{{#if (equals depName 'vite-plus')}}{{{newVersion}}}{{/if}}{{/each}} vp migrate --no-interactive{{else}}pnpm install --no-frozen-lockfile --ignore-scripts{{/if}}",
					"pnpm exec dprint fmt"
				],
				"executionMode": "branch",
				"fileFilters": ["**/*"],
				"installTools": { "node": {}, "pnpm": {} }
			},
			"prBodyNotes": [
				"Vite Plus upgrades run the selected release's official `vp migrate --no-interactive` before installing new project dependencies. Review the generated source/configuration changes and any manual migration findings in the Renovate logs."
			]
		},
		{
			"description": "The official Vite Plus migrator owns bundled Vite/Vitest versions; independently released plugins remain eligible for updates",
			"matchPackageNames": [
				"vite",
				"vitest",
				"@vitest/*",
				"!@vitest/eslint-plugin",
				"!@vitest/browser-webdriverio",
				"@voidzero-dev/vite-plus-core"
			],
			"enabled": false
		},
		{
			"groupName": "vscode language client and server",
			"matchPackageNames": ["vscode-languageclient", "vscode-languageserver"],
			"separateMajorMinor": false,
			"groupSingleUpdates": true
		},
		{
			"groupName": "changesets",
			"matchPackageNames": [
				"@changesets/cli",
				"@changesets/config",
				"changesets/action"
			]
		},
		{
			"matchManagers": ["github-actions"],
			"dependencyDashboardApproval": true
		},
		{
			"groupName": "refractor render corpus",
			"matchPackageNames": [
				"@radix-ui/react-dialog",
				"@radix-ui/react-slot",
				"mantinedev/mantine",
				"shadcn-ui/ui"
			]
		},
		{
			"matchPackageNames": [
				"@atom.io/eslint-plugin",
				"atom.io",
				"@breakage/changesets",
				"breakage",
				"comline",
				"correctly",
				"takua",
				"treetrunks"
			],
			"minimumReleaseAge": null,
			"matchDatasources": [
				"npm"
			],
			"description": "Exempt consumed jeremybanka packages at every version; keep aligned with pnpm-workspace.yaml"
		},
		{
			"matchPackageNames": [
				"dprint",
				"@dprint/*",
				"/^dprint-plugin-/"
			],
			"postUpgradeTasks": {
				"commands": [
					"pnpm install --frozen-lockfile",
					"pnpm exec correctly schemas pull --association 'Dprint'"
				],
				"executionMode": "branch",
				"fileFilters": [
					".correctly/**"
				],
				"installTools": {
					"node": {},
					"pnpm": {}
				}
			}
		},
		{
			"matchPackageNames": [
				"renovatebot/github-action",
				"ghcr.io/renovatebot/renovate"
			],
			"postUpgradeTasks": {
				"commands": [
					"pnpm install --frozen-lockfile",
					"pnpm exec correctly schemas pull --association 'Renovate'"
				],
				"executionMode": "branch",
				"fileFilters": [
					".correctly/**"
				],
				"installTools": {
					"node": {},
					"pnpm": {}
				}
			}
		},
		{
			"matchPackageNames": [
				"jdx/mise",
				"jdx/mise-action"
			],
			"postUpgradeTasks": {
				"commands": [
					"pnpm install --frozen-lockfile",
					"pnpm exec correctly schemas pull --association 'Mise'"
				],
				"executionMode": "branch",
				"fileFilters": [
					".correctly/**"
				],
				"installTools": {
					"node": {},
					"pnpm": {}
				}
			}
		},
		{
			"matchPackageNames": [
				"pnpm"
			],
			"postUpgradeTasks": {
				"commands": [
					"pnpm install --frozen-lockfile",
					"pnpm exec correctly schemas pull --association 'pnpm workspace'"
				],
				"executionMode": "branch",
				"fileFilters": [
					".correctly/**"
				],
				"installTools": {
					"node": {},
					"pnpm": {}
				}
			}
		}
	]
}
